{
  "name": "@leandrotca/conexus-harness",
  "version": "0.1.0",
  "description": "A parte agêntica do Conexus, construída com as peças nativas do Mastra.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developmentconexus-ops/conexus-harness.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "mastra dev",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack-smoke": "bash scripts/pack-smoke.sh",
    "check": "npm run typecheck && npm test && npm run build && npm run pack-smoke",
    "template:build": "node --env-file=.env e2b/build-template.ts",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.86.0-0 <2.0.0-0",
    "@mastra/memory": ">=1.41.3-0 <2.0.0-0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@mastra/core": "1.86.0",
    "@mastra/e2b": "0.18.1",
    "@mastra/memory": "1.41.3",
    "@mastra/observability": "1.24.3",
    "@mastra/pg": "1.38.0",
    "@types/node": "24.19.4",
    "e2b": "2.66.0",
    "mastra": "1.40.2",
    "typescript": "5.9.3",
    "vitest": "5.1.2",
    "zod": "4.6.7"
  }
}
